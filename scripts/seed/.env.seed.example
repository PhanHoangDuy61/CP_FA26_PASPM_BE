# Copy to .env.seed (git-ignored) and replace every CHANGE_ME. Never commit real values.
# The backend must have been started on an EMPTY database with BOOTSTRAP_EMAIL / BOOTSTRAP_PASSWORD
# set to the same values as SEED_SYSADMIN_EMAIL / SEED_SYSADMIN_PASSWORD (12-72 characters,
# at least one lower-case letter, one upper-case letter and one digit).

SEED_API_URL=http://127.0.0.1:8080
SEED_MAILPIT_URL=http://127.0.0.1:8025

SEED_SYSADMIN_EMAIL=sysadmin@paspm.example
SEED_SYSADMIN_PASSWORD=CHANGE_ME

SEED_STORE_ADMIN_EMAIL=storeadmin@paspm.example
SEED_MERCHANDISER_EMAIL=merchandiser@paspm.example
SEED_CUSTOMER_EMAIL=customer@paspm.example
# One password for the three accounts the script creates (same password rules).
SEED_ACCOUNT_PASSWORD=CHANGE_ME

# Optional
#SEED_STORE_NAME=FoodMart Benchmark
#SEED_CATEGORY_NAME=FoodMart Imported Items
#SEED_BATCH_QUANTITY=1000
#SEED_DATA_DIR=scripts/seed/data
#SEED_OUTPUT_DIR=scripts/seed/out     # git-ignored; mapping.csv + import-ready CSV copies go to <dir>/<SEED_STORE_SLUG>/
# Reads SQL on stdin; used only for the final record counts (the Store is created with POST /api/system/stores).
#SEED_STORE_SLUG=foodmart-benchmark
#SEED_SQL_COMMAND=docker compose -f compose.yml exec -T mysql sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" paspm'

# Weight v2 / F06 demo data (all optional; defaults shown; see scripts/seed/README.md)
#SEED_WEIGHT_V2=1                      # 0 skips expiry dates, push days, seasons and the weight configuration
#SEED_AS_OF=2026-11-17                 # default: today in Asia/Ho_Chi_Minh
#SEED_RANDOM_SEED=paspm-demo-weight-v2
#SEED_EXPIRY_PRODUCT_PCT=35            # share of products with requiresExpiry=true
#SEED_EXPIRY_EDGE_PCT=3                # expired yesterday / expires today (half each)
#SEED_EXPIRY_SOON_PCT=15               # expires in 0-7 days
#SEED_EXPIRY_MID_PCT=25                # expires in 8-30 days (the rest: 31-180)
#SEED_PUSH_REACHED_PCT=15              # push day already reached
#SEED_PUSH_MISSING_PCT=25              # no push day (MISSING_PUSH_DAY warning); the rest gets one
#SEED_PUSH_LEAD_MIN_DAYS=3             # push day = expiry - 3..21 days (no fixed 7-day rule)
#SEED_PUSH_LEAD_MAX_DAYS=21
#SEED_EXPIRY_QTY_MIN_PCT=2             # smallest perishable batch, % of SEED_BATCH_QUANTITY
#SEED_WEIGHT_ALPHA=0.6                 # expiry coefficient (alpha + beta must be 1)
#SEED_WEIGHT_BETA=0.4                  # season coefficient
#SEED_WEIGHT_LAMBDA=0.3                # raised lambdaMax by the System Admin only if lower
#SEED_WEIGHT_SALES_WINDOW_DAYS=30      # N; the seeded orders are dated 2026-10-01..04 (see README)
#SEED_SEASON_ACTIVE_WEIGHT=0.7
#SEED_SEASON_OVERLAP_WEIGHT=0.8
#SEED_SEASON_FUTURE_WEIGHT=0.9
#SEED_SEASON_ENDED_WEIGHT=0.6

# TDP-01 (scripts/seed/seed_test_stores.sh): Store B / Store C test accounts for the black-box round.
# Uses SEED_API_URL, SEED_MAILPIT_URL and SEED_SYSADMIN_* above. One password for the four qa-*@paspm.example accounts
# (same password rules as the backend: 12-72 characters, lower-case, upper-case, digit).
SEED_TEST_ACCOUNT_PASSWORD=CHANGE_ME
