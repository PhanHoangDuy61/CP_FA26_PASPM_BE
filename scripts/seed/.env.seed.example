# Copy to .env.seed (git-ignored) and replace every CHANGE_ME. Never commit real values.
# The backend must have been started on an EMPTY database with BOOTSTRAP_EMAIL / BOOTSTRAP_PASSWORD
# set to the same values as SEED_SYSADMIN_EMAIL / SEED_SYSADMIN_PASSWORD (12-72 characters,
# at least one lower-case letter, one upper-case letter and one digit).

SEED_API_URL=http://127.0.0.1:8080
SEED_MAILPIT_URL=http://127.0.0.1:8025

SEED_SYSADMIN_EMAIL=sysadmin@paspm.example
SEED_SYSADMIN_PASSWORD=CHANGE_ME

SEED_STORE_ADMIN_EMAIL=storeadmin@paspm.example
SEED_MERCHANDISER_EMAIL=merchandiser@paspm.example
SEED_CUSTOMER_EMAIL=customer@paspm.example
# One password for the three accounts the script creates (same password rules).
SEED_ACCOUNT_PASSWORD=CHANGE_ME

# Optional
#SEED_STORE_NAME=FoodMart Benchmark
#SEED_CATEGORY_NAME=FoodMart Imported Items
#SEED_BATCH_QUANTITY=1000
#SEED_DATA_DIR=scripts/seed/data
# Reads SQL on stdin; used once for INSERT INTO store (no store endpoint exists) and for the final record counts.
#SEED_SQL_COMMAND=docker compose -f compose.yml exec -T mysql sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" paspm'
