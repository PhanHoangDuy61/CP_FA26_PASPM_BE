# Copy to .env for Docker Compose. Spring Boot does NOT load .env automatically.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
OTP_SECRET=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
GOOGLE_CLIENT_ID=

# Browser sessions: secure HTTPS defaults; set false ONLY for local HTTP.
PASPM_SESSION_COOKIE_SECURE=true
PASPM_SESSION_ALLOWED_ORIGINS=
PASPM_SESSION_REFRESH_TTL_SECONDS=604800
