# Copy to .env on the staging server (git-ignored) and replace every CHANGE_ME. Never commit real values.
# docker compose reads .env from the directory that holds compose.yml.

# --- database (compose.yml) ---
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- backend (compose.backend.yml) ---
# At least 32 bytes each, different from each other, for example: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
OTP_SECRET=CHANGE_ME
# First System Admin, created only when the database is empty: 12-72 characters, with lower case, upper case and a digit.
BOOTSTRAP_EMAIL=sysadmin@paspm.example
BOOTSTRAP_PASSWORD=CHANGE_ME
# Image to run; keep the previous tag to roll back (docker image ls paspm-backend).
PASPM_BACKEND_IMAGE=paspm-backend:CHANGE_ME_TAG
# Host port bound on 127.0.0.1 only; put a reverse proxy or an SSH tunnel in front of it.
PASPM_BACKEND_HOST_PORT=8080
