Family=Arial;fontSize=13;fontStyle=1;fontColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1340" y="60" width="330" height="20" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1340" y="90" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt0" value="V14 / V9 base column" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;fontColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1376" y="88" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=0;html=1;fillColor=#F3F3F3;strokeColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1340" y="116" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt1" value="V15 frozen execution context (nullable)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;fontColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1376" y="114" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=0;html=1;fillColor=#DCEBFF;strokeColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1340" y="142" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt2" value="V16 / V17 lease, fence, retry columns" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;fontColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1376" y="140" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=0;html=1;fillColor=#FFE0B2;strokeColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1340" y="168" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt3" value="V18: SKIPPED status, skip_reason, failure_message" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;fontColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1376" y="166" width="300" height="22" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=0;html=1;fillColor=#CFF1D6;strokeColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1340" y="194" width="28" height="18" as="geometry"/></mxCell><mxCell id="lgt4" value="V19: SYSTEM_SCHEDULER role and principal row" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontStyle=0;fontColor=#28253D;" vertex="1" parent="1"><mxGeometry x="1376" y="192" width="300" height="22" as="geometry"/></mxCell><mxCell id="n_state" value="Status: IMPLEMENTED but GATED. Scheduling is OFF by default (paspm.mining.schedule-dispatch-enabled=false): enabling a schedule answers HTTP 503, no dispatcher thread runs. Not RELEASE_APPROVED; GitHub CI NOT RUN; native Linux NOT RUN.

Occurrence states: PENDING → PROCESSING → DISPATCHED → COMPLETED | FAILED; PENDING ⇄ PROCESSING on retry (3 attempts, 15 s / 30 s); SKIPPED is terminal at birth (D6) and owns no snapshot, request, run or actor." style="shape=note;size=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Arial;fontSize=11;fillColor=#FFF4CC;strokeColor=#9A6700;" vertex="1" parent="1"><mxGeometry x="1340" y="240" width="330" height="215" as="geometry"/></mxCell><mxCell id="n_inv" value="Enforced by the database: UNIQUE (schedule_id, scheduled_at); UNIQUE (store_id, request_key) on occurrence and on mining_request (one request per occurrence); ck_occurrence_status (six values); ck_occurrence_skip_reason (reason exactly when SKIPPED); composite foreign keys keep every child inside one Store.

Enforced by code and tests only: SKIPPED rows carry no snapshot/request/actor; at most one snapshot per occurrence; only the principal executes; a stale owner cannot commit (row lock + lease/fence predicates).

Known limit: TIMESTAMP columns end at 2038-01-19." style="shape=note;size=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Arial;fontSize=11;fillColor=#EEF3FA;strokeColor=#4A6FA5;" vertex="1" parent="1"><mxGeometry x="1340" y="620" width="330" height="250" as="geometry"/></mxCell><mxCell id="n_src" value="Source: docs/architecture/F05_SCHEDULER_SCHEMA_V14_V19.md and docs/diagrams/09-f05-scheduler-erd-v14-v19.mmd (same content as text). The F02 and F03 ERD files are separate and unchanged; they do not show V18/V19." style="shape=note;size=12;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Arial;fontSize=11;fillColor=#EEF3FA;strokeColor=#4A6FA5;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="500" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>