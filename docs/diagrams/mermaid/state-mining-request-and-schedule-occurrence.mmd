stateDiagram-v2
  state "Mining Request State" as MiningRequest {
    state "PENDING" as REQ_PENDING
    state "RUNNING" as REQ_RUNNING
    state "COMPLETED" as REQ_COMPLETED
    state "FAILED" as REQ_FAILED
    [*] --> REQ_PENDING : request and runs persisted
    REQ_PENDING --> REQ_RUNNING : claim / lease acquired, fence+1
    REQ_RUNNING --> REQ_RUNNING : lease expired [owner lost] / reclaimed by another instance, fence+1
    REQ_RUNNING --> REQ_COMPLETED : [all selected runs COMPLETED and comparison is not FAILED]
    REQ_RUNNING --> REQ_FAILED : a run FAILED / TIMED_OUT, or comparison FAILED
    REQ_COMPLETED --> [*]
    REQ_FAILED --> [*]
  }
  state "Schedule Occurrence State" as ScheduleOccurrence {
    state "PENDING" as OCC_PENDING
    state "SKIPPED" as OCC_SKIPPED
    state "PROCESSING" as OCC_PROCESSING
    state "DISPATCHED" as OCC_DISPATCHED
    state "COMPLETED" as OCC_COMPLETED
    state "FAILED" as OCC_FAILED
    [*] --> OCC_PENDING : latest due fire time reserved
    [*] --> OCC_SKIPPED : older missed fire time superseded
    OCC_PENDING --> OCC_PROCESSING : claim: lease, fence+1, attempt+1
    OCC_PROCESSING --> OCC_PENDING : retryable failure, attempt < 3: retry at +15 s, then +30 s
    OCC_PROCESSING --> OCC_PROCESSING : lease expired [owner lost] / reclaimed by another instance, fence+1
    OCC_PROCESSING --> OCC_DISPATCHED : snapshot + request committed in one transaction
    OCC_PROCESSING --> OCC_FAILED : non-retryable error, or 3rd retryable failure (RETRY_EXHAUSTED)
    OCC_DISPATCHED --> OCC_COMPLETED : request COMPLETED (reconcile)
    OCC_DISPATCHED --> OCC_FAILED : request FAILED (MINING_FAILED)
    OCC_COMPLETED --> [*]
    OCC_FAILED --> [*]
    OCC_SKIPPED --> [*]
  }
