flowchart TB
  subgraph Frontend["Frontend"]
    react["React + TypeScript SPA"] --> router["Path-to-screen map\nHistory API navigation + role screen guard"]
    router --> views["Auth · Utility · Store Admin · Mining · Merchandiser · Storefront views"]
    views --> http["fetch API clients\nBearer token in local storage"]
    demo["Interactions\nmining jobs · campaign/simulation · storefront checkout"]
  end
  http -->|"API requests"| api["Spring MVC REST controllers\nAuth · Users · Catalog · Inventory · Import · Utility · Mining · Recommendation"]
  api --> security["Spring Security\nJWT authentication + role checks"]
  security --> services["Application services\nvalidation · store scoping · transactions"]
  services --> repos["JDBC repositories"]
  repos --> mysql[("MySQL")]
  services --> utility["Utility calculation\nS/M product priorities; E from sellable batch expiry"]
  utility --> source["TransactionSource\neligible sales transactions"]
  source --> mysql
  utility --> frozen["Utility snapshot\nsource hash + matrix hash + frozen rows"]
  frozen --> mysql
  services --> input["Mining input builder\nnormalized frozen utility matrix"]
  input --> worker["Mining worker\nrequest/run persistence and status updates"]
  worker --> child["Isolated SPMF child process\nHUI-Miner / EFIM"]
  child --> worker
  worker --> mysql
  services --> rec["Recommendation rules\nfrozen evidence + live product eligibility"]
  rec --> mysql
  services --> mail["Email / Google integrations\nwhen configured"]
  views --> demo
