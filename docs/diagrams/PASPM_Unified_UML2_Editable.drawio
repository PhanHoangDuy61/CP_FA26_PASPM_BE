        <mxCell id="calc" value="Per product: U_expiry by FEFO over batch push days with sales rate v of the last N days; M = highest active season weight (start and end dates included)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#8092A3;strokeWidth=1.2;fontSize=17;fontColor=#223247;spacing=8;" vertex="1" parent="1">
