          <mxGeometry x="726" y="720" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wf" value="W = 1 + λ(α·U_expiry + β·M), rounded to 2 decimals HALF_UP; WeightedUtility = Base × W (scale 6)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#8092A3;strokeWidth=1.2;fontSize=17;fontColor=#223247;spacing=8;" vertex="1" parent="1">
