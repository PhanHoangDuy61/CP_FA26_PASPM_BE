2-08s-node-ACTIVE"><mxGeometry relative="1" as="geometry"><mxPoint x="200.0" y="126.0" as="sourcePoint" /><mxPoint x="200.0" y="250.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="r2-08s-edge-label-0" value="Store created by System Admin" style="html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#28253D;text;fillColor=#FFFFFF;strokeColor=none;spacing=2;align=center;" vertex="1" parent="1"><mxGeometry x="85.0" y="172.0" width="230.0" height="30.0" as="geometry" /></mxCell><mxCell id="r2-08s-edge-1" value="" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.4;fontFamily=Arial;fontSize=15;strokeColor=#28253d;endArrow=open;endFill=0;exitX=1.0;exitY=0.25;exitPerimeter=0;entryX=0.0;entryY=0.25;entryPerimeter=0;" edge="1" parent="1" source="r2-08s-node-ACTIVE" target="r2-08s-node-INACTIVE"><mxGeometry relative="1" as="geometry"><mxPoint x="280.0" y="262.0" as="sourcePoint" /><mxPoint x="520.0" y="262.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="r2-08s-edge-label-1" value="deactivate [System Admin]" style="html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#28253D;text;fillColor=#FFFFFF;strokeColor=none;spacing=2;align=center;" vertex="1" parent="1"><mxGeometry x="290.0" y="222.0" width="220.0" height="30.0" as="geometry" /></mxCell><mxCell id="r2-08s-edge-2" value="" style="html=1;rounded=0;endArrow=open;endFill=0;strokeColor=#333333;strokeWidth=1.4;fontFamily=Arial;fontSize=15;strokeColor=#28253d;endArrow=open;endFill=0;exitX=0.0;exitY=0.75;exitPerimeter=0;entryX=1.0;entryY=0.75;entryPerimeter=0;" edge="1" parent="1" source="r2-08s-node-INACTIVE" target="r2-08s-node-ACTIVE"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="286.0" as="sourcePoint" /><mxPoint x="280.0" y="286.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="r2-08s-edge-label-2" value="reactivate [System Admin]" style="html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#28253D;text;fillColor=#FFFFFF;strokeColor=none;spacing=2;align=center;" vertex="1" parent="1"><mxGeometry x="290.0" y="296.0" width="220.0" height="30.0" as="geometry" /></mxCell><mxCell id="r2-08s-note-active" value="ACTIVE: users of the Store sign in and work; schedulers include it; public branding images are served. On reactivate, deactivated_at / deactivated_by are cleared." style="shape=note;size=14;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=14;fontColor=#28253D;fillColor=#ffffff;strokeColor=#28253d;strokeWidth=1.1;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="380.0" width="320.0" height="100.0" as="geometry" /></mxCell><mxCell id="r2-08s-note-inactive" value="INACTIVE: its users get 403 STORE_INACTIVE; schedulers skip it; no new jobs or user assignments (409 STORE_INACTIVE); in-flight jobs finish; history stays readable; public images and the public Storefront return 404. deactivated_at / deactivated_by are set." style="shape=note;size=14;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=14;fontColor=#28253D;fillColor=#ffffff;strokeColor=#28253d;strokeWidth=1.1;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="440.0" y="380.0" width="320.0" height="140.0" as="geometry" /></mxCell><mxCell id="r2-08s-note-rules" value="Each transition checks expectedVersion (stale &amp;#8594; 409). Stores are never deleted, so there is no final state." style="shape=note;size=14;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=14;fontColor=#28253D;fillColor=#ffffff;strokeColor=#28253d;strokeWidth=1.1;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="560.0" width="720.0" height="50.0" as="geometry" /></mxCell><mxCell id="r2-08s-link-active" value="" style="html=1;rounded=0;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#28253d;strokeWidth=1.1;" edge="1" parent="1" source="r2-08s-note-active" target="r2-08s-node-ACTIVE"><mxGeometry relative="1" as="geometry"><mxPoint x="200.0" y="380.0" as="sourcePoint" /><mxPoint x="200.0" y="298.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="r2-08s-link-inactive" value="" style="html=1;rounded=0;endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#28253d;strokeWidth=1.1;" edge="1" parent="1" source="r2-08s-note-inactive" target="r2-08s-node-INACTIVE"><mxGeometry relative="1" as="geometry"><mxPoint x="600.0" y="380.0" as="sourcePoint" /><mxPoint x="600.0" y="298.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram>
