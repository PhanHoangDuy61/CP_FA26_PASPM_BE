          <mxGeometry x="174" y="1000" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="frz" value="Freeze inputs, seasons and warnings in an immutable snapshot (scoringVersion)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#8092A3;strokeWidth=1.2;fontSize=17;fontColor=#223247;spacing=8;" vertex="1" parent="1">
