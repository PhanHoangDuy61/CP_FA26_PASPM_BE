        <mxCell id="erd-cataloginventory-note-v28" value="V28: soft delete (deleted_at, deleted_by; DEC-20261124-03). effectiveStatus, daysToExpiry and the MISSING_PUSH_DAY warning of a batch are computed on read; nothing is stored." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
