enter;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontFamily=Arial;fontSize=13;fontStyle=2;" value="campaign_id" vertex="1"><mxGeometry height="17" width="89" x="3853.0" y="2402.0" as="geometry" /></mxCell><mxCell id="erd-logical-fkl-98" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontFamily=Arial;fontSize=13;fontStyle=2;" value="actor_id" vertex="1"><mxGeometry height="17" width="67" x="3310.0" y="2462.0" as="geometry" /></mxCell><mxCell id="erd-logical-fkl-99" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontFamily=Arial;fontSize=13;fontStyle=2;" value="previous_active_campaign_id" vertex="1"><mxGeometry height="17" width="208" x="3855" y="2522.0" as="geometry" /></mxCell><mxCell id="erd-logical-note-product-v26" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=2;fontColor=#555555;" value="V26 dropped product.stock_priority_score, seasonal_priority_score, expiry_push_days (Weight v2: push day per inventory_batch)." vertex="1"><mxGeometry height="40" width="470" x="70" y="815" as="geometry" /></mxCell><mxCell id="erd-logical-note-matrix-legacy" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=2;fontColor=#555555;" value="stock_score / expiry_score / seasonal_score are kept for historical (pre-W2) snapshots; W2 rows use expiry_risk + season_weight (scoringVersion W2_EXPIRY_SEASON_V1)." vertex="1"><mxGeometry height="50" width="470" x="3380" y="680" as="geometry" /></mxCell><mxCell id="erd-logical-note-mining-legacy" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=2;fontColor=#555555;" value="EFIM-only since 2026-11-16: algorithm/algorithms are always EFIM, comparison_status NOT_REQUESTED, compare_algorithms false; comparison values exist only on historical rows." vertex="1"><mxGeometry height="50" width="470" x="2710" y="2975" as="geometry" /></mxCell><mxCell id="erd-logical-note-layout-uk" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=2;fontColor=#555555;" value="Composite tenant keys (store_id, id, …) that only serve as FK targets are not marked UK." vertex="1"><mxGeometry height="20" width="1150" x="3380" y="3090" as="geometry" /></mxCell>        <mxCell id="erd-logical-fk-100" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;startArrow=ERzeroToMany;startSize=10;startFill=0;endArrow=ERzeroToOne;endSize=10;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="erd-logical-t-store-r-deactivated_by" target="erd-logical-t-app_user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="erd-logical-fkl-100" value="deactivated_by" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;spacing=0;whiteSpace=nowrap;fontFamily=Arial;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1532" y="1508" width="105" height="17" as="geometry" /></mxCell>
        <mxCell id="erd-logical-note-product-v28" value="V28 (DEC-20261124-03): product.deleted_at / deleted_by mark a soft-deleted product (both set or both NULL, index (store_id, deleted_at)); status becomes INACTIVE. Batch effectiveStatus and daysToExpiry are computed on read: no column (DEC-20261124-01)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="70" y="863" width="470" height="70" as="geometry" />
        </mxCell>
        <mxCell id="erd-logical-note-product-v29" value="V29 / V30 (DEC-20261125-04): product.image_url and description are the F09 display metadata. V29 also added store.store_slug and store.storefront_enabled; V30 dropped both again. The public key is store.slug (V27); a Store is public exactly when its status is ACTIVE." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="70" y="941" width="470" height="70" as="geometry" />
        </mxCell>
</root>
    </mxGraphModel>
  </diagram>
