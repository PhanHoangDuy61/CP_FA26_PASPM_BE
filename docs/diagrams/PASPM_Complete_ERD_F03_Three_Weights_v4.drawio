        <mxCell id="note" value="F06 / V10: reviewable candidates only. Types: BUNDLE | CROSS_SELL | FBT | BANNER. Review: PENDING_REVIEW → APPROVED or REJECTED; version &gt; 0; review history stores resulting_version and eligibility_check. Frozen policy_snapshot, evidence, generation_eligibility and explanation preserve decision context. Approval does not create executable BUNDLE, CAMPAIGN or LAYOUT records; those retained entities are future downstream concepts." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fillColor=none;strokeColor=none;spacing=8;">
          <mxGeometry x="60" y="1270" width="1360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fk-ledger" value="FOREIGN KEYS — V10; default referential actions (no ON DELETE / ON UPDATE clauses)&lt;br&gt;fk_rec_config_store: recommendation_rule_config(store_id) → store(store_id)&lt;br&gt;fk_rec_config_actor: recommendation_rule_config(updated_by) → app_user(user_id)&lt;br&gt;fk_rec_snapshot: recommendation(store_id,utility_snapshot_id) → utility_snapshot(store_id,snapshot_id)&lt;br&gt;fk_rec_anchor: recommendation(store_id,anchor_product_id) → product(store_id,product_id)&lt;br&gt;fk_rec_creator: recommendation(created_by) → app_user(user_id)&lt;br&gt;fk_rec_reviewer: recommendation(reviewed_by) → app_user(user_id)&lt;br&gt;fk_rec_item_rec: recommendation_item(store_id,recommendation_id) → recommendation(store_id,recommendation_id)&lt;br&gt;fk_rec_item_product: recommendation_item(store_id,product_id) → product(store_id,product_id)&lt;br&gt;fk_rec_source_rec: recommendation_source(store_id,recommendation_id) → recommendation(store_id,recommendation_id)&lt;br&gt;fk_rec_source_run: recommendation_source(store_id,run_id) → mining_run(store_id,run_id)&lt;br&gt;fk_rec_source_pattern: recommendation_source(store_id,pattern_id) → high_utility_pattern(store_id,pattern_id)&lt;br&gt;fk_rec_history_rec: recommendation_review_history(store_id,recommendation_id) → recommendation(store_id,recommendation_id)&lt;br&gt;fk_rec_history_reviewer: recommendation_review_history(reviewed_by) → app_user(user_id)" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fillColor=none;strokeColor=none;spacing=8;fontSize=15;">
          <mxGeometry x="1560" y="180" width="1650" height="650" as="geometry" />
        </mxCell>
