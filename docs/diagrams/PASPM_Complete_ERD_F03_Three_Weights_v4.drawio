        <mxCell id="f06full-note" value="F06 / V10: reviewable candidates only. Types: BUNDLE | CROSS_SELL | FBT | BANNER. Review: PENDING_REVIEW → APPROVED or REJECTED; version &gt; 0; review history stores resulting_version and eligibility_check. Frozen policy_snapshot, evidence, generation_eligibility and explanation preserve decision context. Approval does not create executable BUNDLE, CAMPAIGN or LAYOUT records; those retained entities are future downstream concepts." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fillColor=none;strokeColor=none;spacing=8;">
          <mxGeometry x="5200" y="1310" width="1360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="f06full-fk-ledger" value="FOREIGN KEYS — V10; default referential actions (no ON DELETE / ON UPDATE clauses)&lt;br&gt;fk_rec_config_store: recommendation_rule_config(store_id) → store(store_id)&lt;br&gt;fk_rec_config_actor: recommendation_rule_config(updated_by) → app_user(user_id)&lt;br&gt;fk_rec_snapshot: recommendation(store_id,utility_snapshot_id) → utility_snapshot(store_id,snapshot_id)&lt;br&gt;fk_rec_anchor: recommendation(store_id,anchor_product_id) → product(store_id,product_id)&lt;br&gt;fk_rec_creator: recommendation(created_by) → app_user(user_id)&lt;br&gt;fk_rec_reviewer: recommendation(reviewed_by) → app_user(user_id)&lt;br&gt;fk_rec_item_rec: recommendation_item(store_id,recommendation_id) → recommendation(store_id,recommendation_id)&lt;br&gt;fk_rec_item_product: recommendation_item(store_id,product_id) → product(store_id,product_id)&lt;br&gt;fk_rec_source_rec: recommendation_source(store_id,recommendation_id) → recommendation(store_id,recommendation_id)&lt;br&gt;fk_rec_source_run: recommendation_source(store_id,run_id) → mining_run(store_id,run_id)&lt;br&gt;fk_rec_source_pattern: recommendation_source(store_id,pattern_id) → high_utility_pattern(store_id,pattern_id)&lt;br&gt;fk_rec_history_rec: recommendation_review_history(store_id,recommendation_id) → recommendation(store_id,recommendation_id)&lt;br&gt;fk_rec_history_reviewer: recommendation_review_history(reviewed_by) → app_user(user_id)" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fillColor=none;strokeColor=none;spacing=8;fontSize=15;">
          <mxGeometry x="6700" y="220" width="1650" height="650" as="geometry" />
        </mxCell>
        <mxCell id="f06full-owns-recommendation_item" source="f06full-RECOMMENDATION" target="f06full-RECOMMENDATION_ITEM" value="1 : N" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;labelBackgroundColor=#FFFFFF;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f06full-owns-recommendation_source" source="f06full-RECOMMENDATION" target="f06full-RECOMMENDATION_SOURCE" value="1 : N" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;labelBackgroundColor=#FFFFFF;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f06full-owns-recommendation_review_history" source="f06full-RECOMMENDATION" target="f06full-RECOMMENDATION_REVIEW_HISTORY" value="1 : N" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;labelBackgroundColor=#FFFFFF;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f06full-constraints" value="KEYS / CHECKS / INDEXES&lt;br&gt;CONSTRAINT ck_rec_config_version CHECK(config_version &gt; 0)&lt;br&gt;CONSTRAINT uq_recommendation_identity UNIQUE(store_id,identity_hash)&lt;br&gt;CONSTRAINT uq_recommendation_store_id UNIQUE(store_id,recommendation_id)&lt;br&gt;CONSTRAINT ck_rec_type CHECK(type IN ('BUNDLE','CROSS_SELL','FBT','BANNER'))&lt;br&gt;CONSTRAINT ck_rec_anchor_type CHECK((type='CROSS_SELL' AND anchor_product_id IS NOT NULL) OR (type&lt;&gt;'CROSS_SELL' AND anchor_product_id IS NULL))&lt;br&gt;CONSTRAINT ck_rec_utility CHECK(utility&gt;=0 AND (support_count IS NULL OR support_count&gt;=0))&lt;br&gt;CONSTRAINT ck_rec_version CHECK(version&gt;0 AND policy_version&gt;0)&lt;br&gt;CONSTRAINT ck_rec_review CHECK(review_status IN ('PENDING_REVIEW','APPROVED','REJECTED'))&lt;br&gt;CONSTRAINT ck_rec_review_fields CHECK((review_status='PENDING_REVIEW' AND reviewed_by IS NULL AND reviewed_at IS NULL AND review_reason IS NULL) OR (review_status&lt;&gt;'PENDING_REVIEW' AND reviewed_by IS NOT NULL AND reviewed_at IS NOT NULL AND review_reason IS NOT NULL))&lt;br&gt;CREATE INDEX ix_rec_store_snapshot ON recommendation(store_id,utility_snapshot_id,recommendation_id);&lt;br&gt;CREATE INDEX ix_rec_store_review_type ON recommendation(store_id,review_status,type,recommendation_id);&lt;br&gt;PRIMARY KEY(recommendation_id,product_id)&lt;br&gt;PRIMARY KEY(recommendation_id,run_id,pattern_id)&lt;br&gt;CREATE INDEX ix_rec_source_run ON recommendation_source(store_id,run_id,recommendation_id);&lt;br&gt;CONSTRAINT uq_rec_history_version UNIQUE(recommendation_id,resulting_version)&lt;br&gt;CONSTRAINT ck_rec_history_transition CHECK(old_status='PENDING_REVIEW' AND new_status IN ('APPROVED','REJECTED'))&lt;br&gt;CONSTRAINT ck_rec_history_version CHECK(resulting_version&gt;1)" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fillColor=none;strokeColor=none;spacing=8;">
          <mxGeometry x="6700" y="910" width="1650" height="750" as="geometry" />
        </mxCell>
        <mxCell id="f06full-pointer" source="RECOMMENDATION" target="f06full-RECOMMENDATION" value="full V10 schema" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;labelBackgroundColor=#FFFFFF;fontSize=12;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
