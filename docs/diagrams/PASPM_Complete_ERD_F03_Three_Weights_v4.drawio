        <mxCell id="f06full-fk-9" source="MINING_RUN" target="f06full-RECOMMENDATION_SOURCE" value="fk_rec_source_run" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;labelBackgroundColor=#FFFFFF;fontSize=12;">
