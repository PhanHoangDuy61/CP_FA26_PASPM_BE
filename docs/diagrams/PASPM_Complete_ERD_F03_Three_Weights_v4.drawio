          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="constraints" value="KEYS / CHECKS / INDEXES&lt;br&gt;CONSTRAINT ck_rec_config_version CHECK(config_version &gt; 0)&lt;br&gt;CONSTRAINT uq_recommendation_identity UNIQUE(store_id,identity_hash)&lt;br&gt;CONSTRAINT uq_recommendation_store_id UNIQUE(store_id,recommendation_id)&lt;br&gt;CONSTRAINT ck_rec_type CHECK(type IN ('BUNDLE','CROSS_SELL','FBT','BANNER'))&lt;br&gt;CONSTRAINT ck_rec_anchor_type CHECK((type='CROSS_SELL' AND anchor_product_id IS NOT NULL) OR (type&lt;&gt;'CROSS_SELL' AND anchor_product_id IS NULL))&lt;br&gt;CONSTRAINT ck_rec_utility CHECK(utility&gt;=0 AND (support_count IS NULL OR support_count&gt;=0))&lt;br&gt;CONSTRAINT ck_rec_version CHECK(version&gt;0 AND policy_version&gt;0)&lt;br&gt;CONSTRAINT ck_rec_review CHECK(review_status IN ('PENDING_REVIEW','APPROVED','REJECTED'))&lt;br&gt;CONSTRAINT ck_rec_review_fields CHECK((review_status='PENDING_REVIEW' AND reviewed_by IS NULL AND reviewed_at IS NULL AND review_reason IS NULL) OR (review_status&lt;&gt;'PENDING_REVIEW' AND reviewed_by IS NOT NULL AND reviewed_at IS NOT NULL AND review_reason IS NOT NULL))&lt;br&gt;CREATE INDEX ix_rec_store_snapshot ON recommendation(store_id,utility_snapshot_id,recommendation_id);&lt;br&gt;CREATE INDEX ix_rec_store_review_type ON recommendation(store_id,review_status,type,recommendation_id);&lt;br&gt;PRIMARY KEY(recommendation_id,product_id)&lt;br&gt;PRIMARY KEY(recommendation_id,run_id,pattern_id)&lt;br&gt;CREATE INDEX ix_rec_source_run ON recommendation_source(store_id,run_id,recommendation_id);&lt;br&gt;CONSTRAINT uq_rec_history_version UNIQUE(recommendation_id,resulting_version)&lt;br&gt;CONSTRAINT ck_rec_history_transition CHECK(old_status='PENDING_REVIEW' AND new_status IN ('APPROVED','REJECTED'))&lt;br&gt;CONSTRAINT ck_rec_history_version CHECK(resulting_version&gt;1)" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fillColor=none;strokeColor=none;spacing=8;">
          <mxGeometry x="1560" y="870" width="1650" height="750" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>